{
    "name": "eamirgh/snapp-pay-laravel",
    "description": "Production-ready, resilient SnappPay BNPL payment gateway integration for Laravel 11, 12, and 13",
    "keywords": [
        "laravel",
        "snapppay",
        "snapp-pay",
        "bnpl",
        "installment",
        "payment",
        "gateway",
        "iran",
        "fintech"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Amir Ghaffari",
            "email": "eamirgh@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Eamirgh\\SnappPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eamirgh\\SnappPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eamirgh\\SnappPay\\SnappPayServiceProvider"
            ],
            "aliases": {
                "SnappPay": "Eamirgh\\SnappPay\\Facades\\SnappPay"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
